md"""
## Upload droplet image

Select an image from your computer below for which you would like to detect the droplet shape. 

If no image is selected, the notebook will run an example image.
"""

# ╔═╡ 7d38aebc-d602-426a-8b38-f67f26ed467a
@bind chosen_file FilePicker([MIME("image/*")])

# ╔═╡ 176dfcc1-4760-4af5-a3e3-9c60aba15ab6
# img = load_file(chosen_file)

# ╔═╡ 808b0c4e-f5e5-4f8c-b87e-af2e2ae313af
begin
	if chosen_file !== nothing
		img_bytes = chosen_file["data"] 
		img = load(IOBuffer(img_bytes))
	else 
		img_url = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSpSdtJ3NdDYxIp5-Abe9PifEG_y-fDQP-QchWxLoLXMMpSfVtgRy0FKYS1GmWTjxx_QRs&usqp=CAU"
		img_file = download(img_url)
		img = load(img_file)
	end
end

# ╔═╡ fed39f0d-d6a8-4c02-8820-c79ef97ae0aa
display_width = 600  # keep this in sync with the scale calc below

# ╔═╡ c6449b7a-c726-4b9c-8056-8b43405c6986
@bind roi_raw RectangleSelector(img; display_width=display_width)

# ╔═╡ f5564d7d-3064-48a4-9369-b056cc59f416
@bind weight PlutoUI.Slider(0.1:0.1:1.0; default=0.5, show_value=true)

# ╔═╡ b27f1503-c683-46eb-9734-7fcb4a4283fd
begin 
	roi_img, orig_x_min, orig_y_min = extract_roi(img, roi_raw, display_width)
	gradient_magnitude, smoothed_img = find_max_gradients(roi_img)
	binary_mask, labeled_mask, component_length = build_binary_mask(gradient_magnitude, smoothed_img, weight)

	Gray.(binary_mask)
end

# ╔═╡ e22b5b0b-0463-42a8-9440-f4b591310a3b
@bind best_label PlutoUI.Slider(1:length(component_length); default=1, show_value=true)

# ╔═╡ 8f586dbb-8249-4d40-8abf-9f65306cabeb
@bind offset PlutoUI.Slider(-5:1:5; default=-1, show_value=true)

# ╔═╡ c9392ed0-c3b4-4c9e-9d36-9b9da49b331d
begin
	droplet_mask, boundary_mask = extract_boundary_coordinates(labeled_mask, best_label, offset; contour_thickness=1)
	nothing
end

